# intro-topic-bot の設定一覧。
# 単体起動: このファイルをコピーした .env をリポジトリ直下（起動するディレクトリ）に置く。
# 既存 bot へ組み込む場合: ここの項目をホスト bot 側の環境変数として設定する
#   （すでに設定済みの環境変数は .env より優先されるので、二重管理にはならない）。
#   DISCORD_TOKEN だけは組み込みでは不要（ログインするのはホスト bot のため）。

# Discord Bot トークン（Developer Portal > Bot > Reset Token）。
# 必要なのは単体起動（bot.py）でログインするときだけ。
# 既存 bot へ組み込む場合はホスト bot がログインするので設定不要
DISCORD_TOKEN=

# Gemini API キー（https://aistudio.google.com で取得）。任意。
# 空にすると定型お題モードになり、自己紹介は読まずに内蔵の定型お題だけを投稿する
# （自己紹介からお題を作らせるには設定が必要。try_gemini.py の実行にも必要）
GEMINI_API_KEY=

# 使用モデル
GEMINI_MODEL=gemini-3.5-flash

# チャンネル ID（Discord の開発者モードで右クリック→IDをコピー）
INTRO_CHANNEL_ID=
CHAT_CHANNEL_ID=

# 毎日のニュースが流れるチャンネル ID（空 / 0 で無効）。
# 新規の自己紹介が無い回に、直近のニュースを入口にしたお題を生成する素材源。
# Bot にそのチャンネルの View Channel / Read Message History 権限が必要
NEWS_CHANNEL_ID=

# 投稿タイミング制御。E2E テスト時は短縮する（例: MIN_DELAY=1, QUIET=1, INTERVAL=0）
MIN_DELAY_MINUTES=30

# 静穏判定（Discord の返信ラグ対応）:
# 直近 ACTIVITY_WINDOW_MINUTES 分の発言が BUSY_THRESHOLD 件以上なら「会話中」とみなし
# QUIET_BUSY_MINUTES の静穏を要求。未満なら QUIET_MINUTES でよい
QUIET_MINUTES=15
QUIET_BUSY_MINUTES=45
ACTIVITY_WINDOW_MINUTES=60
BUSY_THRESHOLD=3

# お題の投下間隔（時間）。48 = 2日に1回
POST_INTERVAL_HOURS=48

# お題を投下してよい時間帯（JST、この時刻以上〜未満）
POST_WINDOW_START=19
POST_WINDOW_END=22

# 自己紹介とみなす最小文字数
MIN_INTRO_LENGTH=50

# 使用済み自己紹介の本文を再利用プールに保持する日数（プライバシー配慮。過ぎたら削除）
POOL_MAX_AGE_DAYS=90

# 自己紹介にこの絵文字リアクションが付いていたらお題生成に使わない（オプトアウト）
OPTOUT_EMOJI=🚫

# 二択型のお題を Discord の投票機能で投稿する（false/0/no で無効化）
USE_POLL=true

# お題投稿の1行目。お題の形式によらず毎回同じ見出しを使う（空なら既定の「💭 今日のお題」）
TOPIC_TITLE=

# お題の末尾に添える一言（空なら表示しない）。サブテキスト（小さい薄字）で表示する
# 例: TOPIC_FOOTER=一言でも、リアクションだけでも歓迎
TOPIC_FOOTER=

# お題の投稿時にメンションするロール ID（空 / 0 で通知しない）。
# 「お題の通知が欲しい人だけが自分で付けるロール」を想定したオプトイン機能。
# サーバー設定でそのロールの「@mention を許可」を ON にしておくこと
TOPIC_PING_ROLE_ID=

# お題投稿から何時間後に反応（返信・リアクション・投票）を集計するか（1点目）
# 形式の重み学習と few-shot はこの値で計測した行だけを見るため、運用開始後に変更すると
# 過去の計測結果が対象外になり学習が実質リセットされる。決めたら変えないこと
MEASURE_AFTER_HOURS=6

# 2点目の計測時刻（時間）。遅れて伸びた反応を拾う。0 にすると1点計測に戻る。
# 0 でない場合は MEASURE_AFTER_HOURS より大きい値にすること
MEASURE_FINAL_AFTER_HOURS=24

# 最終計測時刻からこの時間を過ぎても計測できないお題は諦めて破棄する
# （権限剥奪などで永久にリトライし続けるのを防ぐ）
MEASURE_GIVEUP_HOURS=72

# /topic backfill で limit を指定しなかったときに #自己紹介 を遡る件数（1〜500）
BACKFILL_SCAN_LIMIT=200

# true にすると実際には投稿せず、投稿予定の内容をログに出すだけ（state も変更しない）
DRY_RUN=false

# 運用ログ（投稿=緑 / 記録=灰 / 再試行=黄 / 要対処=赤 の embed）を流すチャンネル ID（空 / 0 で無効）
# そのチャンネルの Embed Links 権限は任意。無い場合はプレーンテキストで送る
LOG_CHANNEL_ID=

# 管理コマンド /topic（now / stats / queue / status / backfill / pause / resume）を実行できる
# 運用者のユーザー ID。空 / 0 だと誰も実行できないため事実上必須
OWNER_USER_ID=

# state.json の保存先。Railway など再起動でファイルが消える環境では
# 永続ボリュームのパスを指定する（例: /data/state.json）。
# 空なら bot を起動したカレントディレクトリ直下の state.json
STATE_PATH=
