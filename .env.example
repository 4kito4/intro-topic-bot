# Discord Bot トークン（Developer Portal > Bot > Reset Token）
DISCORD_TOKEN=

# Gemini API キー（https://aistudio.google.com で取得）
GEMINI_API_KEY=

# 使用モデル
GEMINI_MODEL=gemini-3-flash

# チャンネル ID（Discord の開発者モードで右クリック→IDをコピー）
INTRO_CHANNEL_ID=
CHAT_CHANNEL_ID=

# 投稿タイミング制御（分）。E2E テスト時は 1 などに短縮する
MIN_DELAY_MINUTES=30
QUIET_MINUTES=15
COOLDOWN_MINUTES=180

# 投稿してよい時間帯（JST、この時刻以上〜未満）
ACTIVE_HOUR_START=9
ACTIVE_HOUR_END=23

# 自己紹介とみなす最小文字数
MIN_INTRO_LENGTH=50
