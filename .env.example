# Discord Bot トークン（Developer Portal > Bot > Reset Token）
DISCORD_TOKEN=

# Gemini API キー（https://aistudio.google.com で取得）
GEMINI_API_KEY=

# 使用モデル
GEMINI_MODEL=gemini-3.5-flash

# チャンネル ID（Discord の開発者モードで右クリック→IDをコピー）
INTRO_CHANNEL_ID=
CHAT_CHANNEL_ID=

# 投稿タイミング制御。E2E テスト時は短縮する（例: MIN_DELAY=1, QUIET=1, INTERVAL=0）
MIN_DELAY_MINUTES=30

# 静穏判定（Discord の返信ラグ対応）:
# 直近 ACTIVITY_WINDOW_MINUTES 分の発言が BUSY_THRESHOLD 件以上なら「会話中」とみなし
# QUIET_BUSY_MINUTES の静穏を要求。未満なら QUIET_MINUTES でよい
QUIET_MINUTES=15
QUIET_BUSY_MINUTES=45
ACTIVITY_WINDOW_MINUTES=60
BUSY_THRESHOLD=3

# お題の投下間隔（時間）。48 = 2日に1回
POST_INTERVAL_HOURS=48

# お題を投下してよい時間帯（JST、この時刻以上〜未満）
POST_WINDOW_START=19
POST_WINDOW_END=22

# 自己紹介とみなす最小文字数
MIN_INTRO_LENGTH=50

# 使用済み自己紹介の本文を再利用プールに保持する日数（プライバシー配慮。過ぎたら削除）
POOL_MAX_AGE_DAYS=90

# 自己紹介にこの絵文字リアクションが付いていたらお題生成に使わない（オプトアウト）
OPTOUT_EMOJI=🚫

# 二択型のお題を Discord の投票機能で投稿する（false/0/no で無効化）
USE_POLL=true

# お題投稿から何時間後に反応（返信・リアクション・投票）を集計するか
MEASURE_AFTER_HOURS=6
